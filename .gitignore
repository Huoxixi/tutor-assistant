# Public allowlist. Local chat data, private reports and machine tools stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/pyproject.toml
!/requirements.txt
!/requirements-wechat.txt
!/requirements-lock.txt
!/run.py
!/start.ps1
!/start.cmd

!/app/
/app/*
!/app/*.py
!/app/static/
/app/static/*
!/app/static/*.html
!/app/static/*.css
!/app/static/*.js
!/app/assets/
/app/assets/*
!/app/assets/regions.json
!/app/assets/regions-source.ts
!/app/assets/regions-LICENSE.txt

!/tests/
/tests/*
!/tests/__init__.py
!/tests/test_wechat_authorization.py
!/tests/test_reference_deduplication.py
!/tests/test_group_selection.py
!/tests/test_split_workflow.py
!/tests/test_collection_failures.py
!/tests/test_public_parser.py

!/tools/
/tools/*
!/tools/__init__.py
!/tools/build_regions.py

!/docs/
/docs/*
!/docs/images/
/docs/images/*
!/docs/images/authorization-preview.png

# Extra protection for runtime files and credentials.
**/__pycache__/
**/.pytest_cache/
**/.venv*/
**/node_modules/
**/.env
**/.env.*
**/*.sqlite*
**/*.db
**/*.dpapi
**/*.pem
**/*.key
**/*.log
**/*.local.json
